  "cards": [
    {
      "dot": "cyan",
      "title": "创建阶段的三道防护",
      "items": [
        "参数或库存校验失败：整个事务回滚，不留任何残留",
        "同幂等键同内容重试：返回已有订单，库存只扣一次",
        "并发同键请求：拿锁后复查 + 唯一约束兜底，自动转为重放"
      ]
    },
    {
      "dot": "amber",
      "title": "异常恢复机制",
      "items": [
        "超时只把支付置为 unknown，不当作失败",
        "重新领取后先查询原交易结果，成功则直接补写回，绝不重复扣款",
        "查询无果按 attempts×5 秒退避重试，超过 5 次转人工排查"
      ]
    },
    {
      "dot": "rose",
      "title": "终态与资源归还",
      "items": [
        "支付成功：支付、订单、任务在同一事务中置为终态",
        "业务失败（余额不足）：订单取消并逐明细回补预留库存",
        "所有任务写回带 version 校验，过期 Worker 的写回整体回滚"
      ]
    }
  ]
