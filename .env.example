# 复制为 .env 后按需修改；改动配置后需重启对应进程。
# 数据库配置、API 的 JWT_SECRET 和支付客户端的 PAYMENT_PROVIDER_URL 为必填。
NODE_ENV=development

# ============================================================
# 数据库 PostgreSQL（Docker 容器 shopping-postgres）
# ============================================================
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=shopping
# 可替代上面的 PG*；一旦设置 DATABASE_URL，将优先使用它（不要保留空赋值）。
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopping
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=5000

# ============================================================
# API 服务（npm run start / dev）
# ============================================================
PORT=3000
# 生产环境务必修改；测试固定使用 test-secret，不读取此值
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=2h

# ============================================================
# 模拟第三方支付平台（npm run provider）
# ============================================================
PAYMENT_PROVIDER_PORT=4100
# success / fail / timeout / drop（丢单演练）
PAYMENT_MOCK_MODE=success
PAYMENT_MOCK_LATENCY_MS=100

# ============================================================
# 支付平台客户端（Worker 与人工对账共用）
# ============================================================
PAYMENT_PROVIDER_URL=http://localhost:4100
PAYMENT_PROVIDER_TIMEOUT_MS=3000

# ============================================================
# Worker（npm run worker）
# ============================================================
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=5
# 0 关闭 Worker 指标端口；启用后多 Worker 必须使用不同端口。
WORKER_METRICS_PORT=9101
# 扣款成功后、本地写回前崩溃：1 开启，0 关闭。
# 修改后需要重新运行 npm run worker。演练时请停掉其他 Worker。
WORKER_CRASH_AFTER_PAY_SUCCESS=0

# ============================================================
# 人工对账（npm run tasks:reconcile）
# ============================================================
# 留空则依次回退到操作系统用户名（USERNAME / USER）
RECONCILIATION_OPERATOR=

# API/Provider/Worker 的 /metrics 共用此 Bearer 凭据。
# 本地可留空；production 必须注入至少 32 字符的独立随机值。
METRICS_TOKEN=
