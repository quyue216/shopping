    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "tasks:dead-letter": "node --env-file-if-exists=.env scripts/list-dead-letter-tasks.js",
    "tasks:reconcile": "node --env-file-if-exists=.env scripts/reconcile-dead-letter-task.js"
