{
  "name": "shopping",
  "version": "1.0.0",
  "description": "PostgreSQL 事务订单、异步支付 Worker、故障恢复与人工对账教学项目",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "worker:dev": "node --env-file-if-exists=.env --watch src/worker.js",
    "provider": "node --env-file-if-exists=.env src/provider.js",
    "provider:dev": "node --env-file-if-exists=.env --watch src/provider.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "docs:check": "node scripts/check-openapi.js",
    "tasks:dead-letter": "node --env-file-if-exists=.env scripts/list-dead-letter-tasks.js",
    "tasks:reconcile": "node --env-file-if-exists=.env scripts/reconcile-dead-letter-task.js"
  },
  "engines": { "node": ">=22.22.0" },
  "volta": { "node": "22.22.0", "npm": "10.9.4" },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prom-client": "^15.1.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0"
  }
}
